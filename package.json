{
  "name": "callflow-production",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "appserver": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "node --test src/lib/*.test.ts",
    "companion:build": "tsc -p companion/tsconfig.json",
    "companion:test": "node --test companion/src/*.test.ts",
    "companion:setup-tls": "bash scripts/setup-callflow-companion-tls.sh",
    "companion:start": "bash scripts/start-callflow-companion.sh",
    "companion:stop": "bash scripts/stop-callflow-companion.sh",
    "companion:check": "bash scripts/check-callflow-companion.sh",
    "companion:start:dev": "bash scripts/start-callflow-companion-dev.sh",
    "companion:stop:dev": "bash scripts/stop-callflow-companion-dev.sh",
    "companion:check:dev": "bash scripts/check-callflow-companion-dev.sh",
    "transcription:setup": "bash scripts/setup-callflow-transcription.sh",
    "transcription:check": "bash scripts/check-callflow-transcription.sh",
    "transcription:benchmark": "bash scripts/benchmark-callflow-transcription.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.110.4",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "openai": "^6.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
